{
  "name": "retrobrew",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "check:assets": "node scripts/check-no-third-party.mjs dist",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test --project=local --project=local-restart",
    "test:e2e:public": "E2E_RELAYS=public playwright test --project=public",
    "test:soak": "E2E_SOAK=1 playwright test --project=soak",
    "gallery": "E2E_GALLERY=1 playwright test --project=gallery"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "idb": "^8.0.3",
    "nostr-tools": "^2.25.2",
    "preact": "^11.0.0",
    "trystero": "^0.25.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.59.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/ws": "8.18.2",
    "fake-indexeddb": "^6.2.5",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "ws": "8.22.0"
  }
}
